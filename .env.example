# Kopieer dit bestand naar .env.local en vul de waarden in.
# Maak een API-key aan op https://resend.com/api-keys
RESEND_API_KEY=

# Adres waar aanmeldingen binnenkomen
CONTACT_TO_EMAIL=

# Afzender; het domein moet in Resend geverifieerd zijn,
# bijvoorbeeld: Defela <aanmelden@jouwdomein.nl>
CONTACT_FROM_EMAIL=

# Adres van de live website (voor sitemap en robots), zonder slash aan het eind
NEXT_PUBLIC_SITE_URL=https://www.voorbeeld.nl

# Laat staan (of leeg) tot de echte livegang: de site is dan niet vindbaar voor Google.
# Zet op true zodra alle plaatshouders vervangen zijn.
NEXT_PUBLIC_ALLOW_INDEXING=false
